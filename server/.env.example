PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mehryat-atelier?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Email (for "Forgot Password" reset emails). Leave blank during development —
# reset links will just print to this terminal instead. Fill these in with
# real SMTP credentials before going live (e.g. a Gmail App Password, or a
# transactional email service like SendGrid / Mailgun / Brevo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mehryat Atelier <support@mehryaatelier.com>

# Product photo storage (for the admin "upload image" feature). Leave blank
# during local development — uploads will save to server/uploads instead.
# Required before deploying to Render (or similar), since free hosting wipes
# local files on redeploy. Get these three values free at cloudinary.com
# (Dashboard → Account Details) after creating an account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
